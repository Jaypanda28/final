# ====================================================================
# SHRI PINNAKEEDGE SMART LMS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and configure your Supabase credentials
# ====================================================================

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase Managed Database & Auth Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Institution Defaults
NEXT_PUBLIC_INSTITUTE_NAME="Shri PinnakeEdge Coaching Center"
NEXT_PUBLIC_PLATFORM_NAME="Shri PinnakeEdge Smart LMS"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_LOCALE="en-IN"
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"

# Storage Bucket Name
NEXT_PUBLIC_STORAGE_BUCKET=educational-materials
